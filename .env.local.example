# AdSense 설정 — 승인 후 값을 채우고 파일명을 .env.local 로 복사하세요.
# 값이 비어 있으면 광고는 표시되지 않으며 사이트에 아무 영향이 없습니다.

# 게시자 ID (AdSense 가입 시 1개 발급)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# 광고 단위(슬롯) ID — 승인 후 대시보드에서 광고 단위를 만들면 발급되는 숫자열
# 계산 결과 하단용
NEXT_PUBLIC_AD_SLOT_CALC=
# 블로그 글 하단용
NEXT_PUBLIC_AD_SLOT_ARTICLE=
